{
  "name": "dsh-xlock",
  "version": "0.2.13",
  "description": "Cross-machine session lock for DSH: block write-open of a session in use on another machine, repair torn logs, triage sync conflicts, record creation origin, sync archive state.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jalousiex/dsh-xlock.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "index.js",
    "client.js",
    "core",
    "cli",
    "locale",
    "config.json",
    "dsh-xlock.ps1",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  }
}
